{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsReleaseOidc",
      "Effect": "Allow",
      "Principal": {
        "Federated": "__OIDC_PROVIDER_ARN__"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:__GITHUB_REPO__:environment:release",
          "token.actions.githubusercontent.com:job_workflow_ref": "__GITHUB_REPO__/.github/workflows/release-jar.yml@refs/heads/main"
        }
      }
    }
  ]
}
